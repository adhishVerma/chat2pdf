# Copy to .env and fill in. Never commit the real file.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; none are needed here.

# --- Auth (built in) ---
# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- Postgres with pgvector (Amazon RDS, EC2, or `docker compose up db`) ---
DATABASE_URL=postgres://chat2pdf:chat2pdf@localhost:5432/chat2pdf
# TLS is on by default (needed for RDS). Set to false for a local database.
DATABASE_SSL=false

# --- S3 (PDF storage). The bucket can stay private. ---
# Use an IAM user/role limited to s3:PutObject, s3:GetObject, s3:DeleteObject on this bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=ap-south-1
# Optional: S3-compatible endpoint such as MinIO (http://localhost:9000)
# S3_ENDPOINT=

# --- OpenAI (chat model and embeddings) ---
OPENAI_API_KEY=
# Optional model overrides (embedding model must output 1536 dimensions)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chat tokens (answers + question rewrites) each user may use per UTC day. Default 200000; 0 = no limit.
# DAILY_CHAT_TOKEN_LIMIT=200000

# --- PDF processing worker ---
# The app server runs the worker by default. Set DISABLE_WORKER=true to run it
# separately with `npm run worker` instead.
# DISABLE_WORKER=false
# WORKER_CONCURRENCY=2

# --- Rate limits (tune in src/lib/rate-limit.ts) ---
# DISABLE_RATE_LIMITS=false

# --- Email (Amazon SES): verification and password reset ---
# Public URL of the app, used in email links
APP_URL=http://localhost:3000
# Verified SES sender. Leave empty in development to print emails to the server log.
EMAIL_FROM=
SES_REGION=ap-south-1
# Optional: SES credentials; otherwise the EC2/ECS role or default AWS credentials are used
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# Require a confirmed email before uploading (default true)
# REQUIRE_EMAIL_VERIFICATION=true
