# Copy to .env and fill in. Never commit the real file.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; none are needed here.

# --- Auth (built in) ---
# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- Postgres with pgvector (Amazon RDS, EC2, or `docker compose up db`) ---
DATABASE_URL=postgres://chat2pdf:chat2pdf@localhost:5432/chat2pdf
# TLS is on by default (needed for RDS). Set to false for a local database.
DATABASE_SSL=false

# --- S3 (PDF storage). The bucket can stay private. ---
# Use an IAM user/role limited to s3:PutObject, s3:GetObject, s3:DeleteObject on this bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=ap-south-1
# Optional: S3-compatible endpoint such as MinIO (http://localhost:9000)
# S3_ENDPOINT=

# --- OpenAI (chat model and embeddings) ---
OPENAI_API_KEY=
# Optional model overrides (embedding model must output 1536 dimensions)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
