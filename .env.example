# Copy to .env (or .env.local) and fill in. Never commit the real file.
# Only variables prefixed NEXT_PUBLIC_ are sent to the browser, so secrets must NOT use that prefix.

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat

# --- Database (Neon Postgres), server only ---
DATABASE_URL=

# --- AWS S3 (PDF storage, region ap-south-1) ---
# Secret: server only. Use an IAM user limited to s3:PutObject/GetObject/DeleteObject on this bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket name is not secret; the browser uses it to display the PDF.
NEXT_PUBLIC_S3_BUCKET_NAME=

# --- OpenAI / Pinecone ---
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Milliseconds to wait after creating a new Pinecone index (default 60000)
INDEX_INIT_TIMEOUT=60000

# --- AWS Lambda that chunks and embeds uploaded PDFs ---
LAMBDA_URL=
